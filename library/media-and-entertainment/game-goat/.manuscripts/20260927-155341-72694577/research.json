  "narrative": {
    "headline": "Look up any game and find what to play next - RAWG search, ratings, franchise order, and tag-matched recommendations with remake-aware title resolution, built for agents.",
    "quickstart": [
      {
        "command": "game-goat-pp-cli auth set-token"
      },
      {
        "command": "game-goat-pp-cli games search \"hollow knight\" --json"
      },
      {
        "command": "game-goat-pp-cli ratings \"hollow knight\" --json"
      },
      {
        "command": "game-goat-pp-cli similar \"hollow knight\" --json"
      }
    ],
    "recipes": [
      {
        "title": "Games like one you loved",
        "command": "game-goat-pp-cli similar \"Megabonk\" --json --select results.name,results.tier,results.reason"
      },
      {
        "title": "Play a franchise in order",
        "command": "game-goat-pp-cli series \"zelda\" --json"
      },
      {
        "title": "Pin a remake when titles collide",
        "command": "game-goat-pp-cli ratings \"resident evil 4\" --year 2023 --json"
      },
      {
        "title": "Will people actually finish it?",
        "command": "game-goat-pp-cli retention \"elden ring\" --json"
      }
    ]
  }
